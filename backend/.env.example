# 데이터베이스
DATABASE_URL=postgresql+psycopg2://cheongyak:cheongyak@localhost:5432/cheongyak

# 청약홈 공공데이터포털 API 키 (data.go.kr에서 발급)
APPLYHOME_API_KEY=

# 금융상품통합비교공시(파인) API 키
FINE_API_KEY=

# 공고 질문 답변용 (없으면 안내문)
OPENAI_API_KEY=

# 비우면 TF-IDF 검색. 공고 임베딩을 쓰려면 nlpai-lab/KURE-v1
RAG_EMBEDDING_MODEL=

APP_ENV=local
